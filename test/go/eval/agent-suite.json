    {
      "id": "summarize-project",
      "name": "Summarize an unfamiliar project",
      "category": "understanding",
      "tags": [
        "python",
        "summary"
      ],
      "prompt": "Give me a concise overview of this project in your final answer (do not create files): what it does, its entry point and commands, how failed jobs are retried (limits and delays), where and how jobs are persisted, and how configuration is loaded (file name and environment override). Do not modify any files.",
      "workspaceFixture": "fixtures/agent-tinyqueue",
      "strictDiff": true,
      "allowedChangedFiles": [],
      "answerChecks": [
        {
          "id": "purpose",
          "anyOf": [
            "job queue",
            "task queue",
            "background job",
            "kolejk",
            "queue of jobs",
            "jobs queue"
          ]
        },
        {
          "id": "entry-point",
          "anyOf": [
            "tinyqueue.cli",
            "cli.py"
          ]
        },
        {
          "id": "commands",
          "allOf": [
            "enqueue",
            "run",
            "stats"
          ]
        },
        {
          "id": "retry-limit",
          "anyOf": [
            "max_attempts",
            "\\b5\\s*(attempts|tries|times|prób|razy)",
            "five"
          ],
          "regex": true
        },
        {
          "id": "backoff",
          "anyOf": [
            "exponential",
            "wykładnicz",
            "doubl",
            "2 ** ",
            "2**"
          ]
        },
        {
          "id": "backoff-cap",
          "anyOf": [
            "\\b60\\b"
          ],
          "regex": true
        },
        {
          "id": "dead-state",
          "anyOf": [
            "dead"
          ]
        },
        {
          "id": "storage",
          "anyOf": [
            "jobs.jsonl",
            "JSON Lines",
            "JSONL",
            "json lines"
          ]
        },
        {
          "id": "config",
          "allOf": [
            "tinyqueue.toml",
            "TINYQUEUE_DB"
          ]
        }
      ]
    },
    {
      "id": "find-implementation",
      "name": "Locate where a behaviour is implemented",
      "category": "understanding",
      "tags": [
        "go",
        "navigation"
      ],
      "prompt": "Where is per-API-key rate limiting actually enforced at request time in this service? Answer with the file path and the function or method that makes the allow/deny decision, and name the configuration setting that controls the rate. Do not modify any files.",
      "workspaceFixture": "fixtures/agent-gateway",
      "strictDiff": true,
      "allowedChangedFiles": [],
      "answerChecks": [
        {
          "id": "file",
          "anyOf": [
            "internal/limits/bucket.go"
          ],
          "critical": true,
          "weight": 2
        },
        {
          "id": "method",
          "anyOf": [
            "\\bAllow\\b"
          ],
          "regex": true,
          "weight": 2
        },
        {
          "id": "config",
          "anyOf": [
            "RateLimitPerMinute",
            "GATEWAY_RPM"
          ]
        },
        {
          "id": "not-legacy",
          "noneOf": [
            "enforced (in|by) [^.\\n]*legacy_window",
            "AllowRequest[^.\\n]*(makes|decides|enforces)"
          ],
          "regex": true
        }
      ]
    },
