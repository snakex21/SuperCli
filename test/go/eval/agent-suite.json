{
  "id": "supercli-agent-suite",
  "name": "SuperCli broad agent evaluation suite",
  "description": "Realistic coding, repo-understanding, editing-precision, long-horizon, tool-hygiene and web tasks on small synthetic Go/Python/JS repos. Graded deterministically (tests incl. hidden grader overlays, diff constraints, file contents) and by fact checklists for answers. Run with go run ./cmd/supercli-evalsuite.",
  "ignoreChangedFiles": [
    "**/__pycache__/**",
    "**/*.pyc",
    "**/node_modules/**"
  ],
  "tasks": [
    {
      "id": "fix-failing-test-go",
      "name": "Fix logic bugs behind a failing Go test",
      "category": "coding",
      "tags": [
        "go",
        "bugfix"
      ],
      "prompt": "`go test ./...` fails in this repository. Find and fix the bug(s) in the production code so the tests pass. Do not modify cart_test.go or go.mod. Run the tests before you finish.",
      "workspaceFixture": "fixtures/agent-cart",
      "graderOverlay": "fixtures/agent-cart-grader",
      "expectedChangedFiles": [
        "cart.go"
      ],
      "forbiddenChangedFiles": [
        "cart_test.go",
        "go.mod"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "cart.go"
      ],
      "verificationCommands": [
        {
          "id": "go-test",
          "args": [
            "go",
            "test",
            "-count=1",
            "./..."
          ]
        }
      ]
    },
    {
      "id": "implement-spec-python",
      "name": "Implement a Python function from its docstring spec",
      "category": "coding",
      "tags": [
        "python",
        "spec"
      ],
      "prompt": "Implement parse_duration in durations/parse.py exactly as its docstring specifies. Do not change the tests. Run the test suite with `python -m unittest discover -s tests -t .` before you finish.",
      "workspaceFixture": "fixtures/agent-durations",
      "graderOverlay": "fixtures/agent-durations-grader",
      "expectedChangedFiles": [
        "durations/parse.py"
      ],
      "forbiddenChangedFiles": [
        "tests/test_parse.py"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "durations/**"
      ],
      "verificationCommands": [
        {
          "id": "unittest",
          "args": [
            "python",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-t",
            "."
          ]
        }
      ]
    },
    {
      "id": "refactor-js",
      "name": "Refactor duplicated JS code without breaking tests",
      "category": "coding",
      "tags": [
        "js",
        "refactor"
      ],
      "prompt": "Refactor src/pricing.js: the currency formatting expression is duplicated in three functions. Extract it into a single helper function named formatMoney(value), export it as well, and make the three existing functions use it. Behaviour must stay identical. Do not modify the tests; run `node --test` before you finish.",
      "workspaceFixture": "fixtures/agent-pricing",
      "graderOverlay": "fixtures/agent-pricing-grader",
      "expectedChangedFiles": [
        "src/pricing.js"
      ],
      "forbiddenChangedFiles": [
        "test/pricing.test.js"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "src/pricing.js"
      ],
      "verificationCommands": [
        {
          "id": "node-test",
          "args": [
            "node",
            "--test"
          ]
        }
      ],
      "fileChecks": [
        {
          "id": "single-format-expression",
          "path": "src/pricing.js",
          "maxOccurrences": {
            "toFixed(2)": 1
          },
          "regex": [
            "formatMoney\\s*(=|\\()"
          ],
          "critical": true
        }
      ]
    },
    {
      "id": "add-cli-flag-go",
      "name": "Add a CLI flag with a test and docs",
      "category": "coding",
      "tags": [
        "go",
        "feature",
        "cli"
      ],
      "prompt": "Add a boolean --upper flag to this greet command that prints the whole greeting in upper case, applied after the punctuation (for example `--upper --name bob --excited` prints `HELLO, BOB!`). Add a test for the new flag to main_test.go and document the flag in the README.md flag table. Run `go test ./...` and `go vet ./...` before you finish.",
      "workspaceFixture": "fixtures/agent-greet",
      "graderOverlay": "fixtures/agent-greet-grader",
      "expectedChangedFiles": [
        "main.go",
        "main_test.go",
        "README.md"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "main.go",
        "main_test.go",
        "README.md"
      ],
      "verificationCommands": [
        {
          "id": "go-test",
          "args": [
            "go",
            "test",
            "-count=1",
            "./..."
          ]
        },
        {
          "id": "go-vet",
          "args": [
            "go",
            "vet",
            "./..."
          ]
        }
      ],
      "fileChecks": [
        {
          "id": "test-added",
          "path": "main_test.go",
          "regex": [
            "(?i)upper"
          ]
        },
        {
          "id": "readme-documents-flag",
          "path": "README.md",
          "contains": [
            "upper"
          ]
        }
      ]
    },
    {
      "id": "fix-race-go",
      "name": "Fix a data race in a shared counter",
      "category": "coding",
      "tags": [
        "go",
        "concurrency"
      ],
      "prompt": "Users report that Counter in stats.go sometimes crashes with 'concurrent map writes' and loses counts when it is used from many goroutines, and that callers iterating Snapshot() see races. Make the type safe for concurrent use without changing its public API. `go test -race ./...` must pass (gcc is installed, so -race works here). Do not modify the tests.",
      "workspaceFixture": "fixtures/agent-stats",
      "graderOverlay": "fixtures/agent-stats-grader",
      "expectedChangedFiles": [
        "stats.go"
      ],
      "forbiddenChangedFiles": [
        "stats_test.go"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "stats.go"
      ],
      "verificationCommands": [
        {
          "id": "go-test-race",
          "args": [
            "go",
            "test",
            "-race",
            "-count=1",
            "./..."
          ],
          "env": [
            "CGO_ENABLED=1"
          ]
        }
      ]
    },
    {
      "id": "multi-file-go",
      "name": "Add a field end to end across several files",
      "category": "coding",
      "tags": [
        "go",
        "multi-file"
      ],
      "prompt": "Add an Email field to users end to end: (1) User gets an `Email string` field; (2) Store.Add takes `(name, email string)`; (3) ExportCSV writes the header `id,name,email` and an email column; (4) ParseCreate accepts lines of the form \"name,email\" and has the signature `ParseCreate(line string) (name, email string, err error)`; it trims spaces around both parts and returns ErrInvalid unless there are exactly two parts, the name is non-empty and the email contains \"@\". Update the existing tests for the new signatures and run `go test ./...`.",
      "workspaceFixture": "fixtures/agent-users",
      "graderOverlay": "fixtures/agent-users-grader",
      "expectedChangedFiles": [
        "model.go",
        "store.go",
        "handler.go"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "*.go"
      ],
      "verificationCommands": [
        {
          "id": "go-test",
          "args": [
            "go",
            "test",
            "-count=1",
            "./..."
          ]
        }
      ]
    },
    {
      "id": "docs-match-code",
      "name": "Update stale docs to match the code",
      "category": "coding",
      "tags": [
        "python",
        "docs"
      ],
      "prompt": "README.md is out of date. Update README.md so that every documented option, default value and environment variable matches the actual code in servecfg/ (remove anything that no longer exists). Do not change any code.",
      "workspaceFixture": "fixtures/agent-servecfg",
      "expectedChangedFiles": [
        "README.md"
      ],
      "strictDiff": true,
      "allowedChangedFiles": [
        "README.md"
      ],
      "fileChecks": [
        {
          "id": "readme-defaults",
          "path": "README.md",
          "contains": [
            "8080",
            "127.0.0.1",
            "--debug",
            "SERVECFG_TOKEN"
          ],
          "regex": [
            "--workers[^\\n]*\\b4\\b"
          ],
          "critical": true
        },
        {
          "id": "readme-stale-removed",
          "path": "README.md",
          "notContains": [
            "8000",
            "0.0.0.0",
            "--verbose",
            "--log-file",
            "`SERVE_TOKEN`"
          ],
          "critical": true
        },
        {
          "id": "readme-kept-structure",
          "path": "README.md",
          "contains": [
            "## Usage",
            "## License"
          ]
        }
      ]
    },
