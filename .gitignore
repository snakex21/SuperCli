# Build outputs
/supercli
/supercli.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
coverage.out
test/perf/*.json

# Runtime state / databases — never publish these.
# Portable app state lives under supercli-data/ only (not repo root).
.supercli/
supercli-data/
# The shared built-in skill pack is distributable application data. Keep every
# user database/config/credential ignored while allowing this one exact asset.
!supercli-data/
supercli-data/*
!supercli-data/skills/
supercli-data/skills/*
!supercli-data/skills/builtin-skills.zip
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/sessions.db*
/memory.db*
sessions.db*
memory.db*

# Local build outputs kept next to build.bat / build_ui.bat for convenience
# (still ignored — never commit binaries)
/supercli-web.exe

# Logs and crash dumps
logs/
*.log
crash.log

# Pricing cache (F28)
pricing_cache.json

# Local memory/pattern state
/memory/
**/.darwin/

# Secrets and local env
.env
.env.*
*.pem
*.key
*.crt
# OAuth token stores (codexauth): <dataDir>/auth.json and the
# per-account <dataDir>/auth-<label>.json. supercli-data/ and
# .supercli/ already cover the default locations; these patterns keep
# them out of the repo from ANY directory, including a data dir a user
# points somewhere else.
auth.json
auth-*.json

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary files / local tool state
/\.tmp-home/
/\.claude/
/%SystemDrive%/
tmp/
temp/
*.tmp
*.bak
